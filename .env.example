# Sahibin ana şifresi. TÜM menülere yetkilidir, müşteriye verilmez.
# Boş bırakılırsa sadece esnaf şifreleriyle giriş yapılır.
ADMIN_PASSWORD=

# Esnaf başına şifre — müşteriye verilecek olan bu. Değişken adı slug'dan
# türer: ADMIN_PASSWORD_<SLUG>, harfler büyük, tire alt çizgi olur.
#   hocaoglu       → ADMIN_PASSWORD_HOCAOGLU
#   tavuk-dunyasi  → ADMIN_PASSWORD_TAVUK_DUNYASI
# Bu şifreyle giren yalnızca kendi menüsünü görür ve düzenler.
# Her esnafa FARKLI şifre ver; aynısını iki esnafa verirsen ikisi de
# ilk eşleşen menüye düşer.
ADMIN_PASSWORD_HOCAOGLU=

# Oturum çerezini imzalar. Uzun ve rastgele olmalı, en az 16 karakter.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Blob kimliği. Vercel'de store'u projeye bağlayınca otomatik gelir —
# güncel modelde BLOB_STORE_ID olarak, kimlik doğrulama OIDC ile yapılır ve
# aşağıdaki token ortamda hiç bulunmaz. Bu normaldir, elle eklemeye gerek yok.
#
# Aşağıdaki değişken yalnızca lokal geliştirmede işe yarar. Boş bırakılırsa
# fiyatlar .data/ altındaki dosyaya yazılır.
#
# Store "Private" olarak oluşturulmalı — lib/menu-store.ts private erişimle
# okuyup yazıyor, public bir store ile eşleşmez.
BLOB_READ_WRITE_TOKEN=

# Open Graph görsellerinin mutlak URL'e çevrilmesi için. Boşsa
# https://cetinnyigit.com varsayılır. QR kartlar bu alan adına basılıyor —
# değiştirmek basılı kartları geçersiz kılar.
NEXT_PUBLIC_SITE_URL=
